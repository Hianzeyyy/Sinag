APP_NAME=Sinag
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

# Vercel Logging
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Remote MySQL Database Configuration (Aiven, PlanetScale, Supabase, AWS RDS, etc.)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Session and Cache drivers (using database instead of file system for serverless)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=sinag-session-v3
SESSION_ALLOW_DATABASE=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_ALLOW_DATABASE=false
QUEUE_CONNECTION=sync

# Mail Configuration
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
