APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Configure the matching OAuth redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Set these in Render Environment Variables and in local .env when an
# administrator should be provisioned automatically after migrations.
ADMIN_EMAIL=
ADMIN_NAME=GAD Administrator
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Set DB_SSL_CA to a readable CA bundle for remote MySQL/TiDB connections.
# Render/Docker uses /etc/ssl/certs/ca-certificates.crt; local Windows/XAMPP
# can use C:/xampp/apache/bin/curl-ca-bundle.crt.
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# DB_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=sinag-session-v3
SESSION_ALLOW_DATABASE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local uploads use the public/local disks. Production defaults to S3 disks;
# configure these AWS-compatible credentials in Render's environment.
# USER_PUBLIC_MEDIA_DISK=public_s3
# USER_PRIVATE_MEDIA_DISK=private_s3
# MEDIA_BACKUP_DRIVER=s3
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_ALLOW_DATABASE=false
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use a Google App Password (with 2-Step Verification enabled), not your
# regular Gmail password. Keep these values in local .env / Render secrets.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.name@psu.edu.ph
MAIL_PASSWORD=your-google-workspace-app-password
MAIL_FROM_ADDRESS=your.name@psu.edu.ph
MAIL_FROM_NAME="SINAG - PSU GAD"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set AWS_ENDPOINT for S3-compatible providers such as Cloudflare R2 or MinIO.
# AWS_ENDPOINT=https://s3.example.com
# Set AWS_URL to the public base URL/CDN when using public_s3 uploads.
# AWS_URL=https://cdn.example.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set Cloudinary credentials in the hosting environment; do not commit them.
CLOUDINARY_URL=

VITE_APP_NAME="${APP_NAME}"
